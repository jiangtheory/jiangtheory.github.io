{% comment %}
  Clean academic awards list for RenderCV format
{% endcomment %}

<div class="cv-awards-list">
  {% for entry in entries %}
    <div class="cv-award">
      {% capture award_date %}
        {% if entry.date %}{{ entry.date }}{% endif %}
      {% endcapture %}

      {% if award_date != '' %}
        <span class="cv-award-date">{{ award_date }}</span>
      {% endif %}

      <div class="cv-award-content">
        {% if entry.url %}
          <h4 class="cv-award-title">
            <a href="{{ entry.url }}">{{ entry.title }}</a>
          </h4>
        {% elsif entry.title %}
          <h4 class="cv-award-title">{{ entry.title }}</h4>
        {% endif %}

        {% if entry.awarder %}
          <div class="cv-awarder">{{ entry.awarder }}</div>
        {% endif %}

        {% if entry.summary %}
          <p class="cv-award-summary">{{ entry.summary | markdownify | remove: '<p>' | remove: '</p>' }}</p>
        {% endif %}
      </div>
    </div>
  {% endfor %}
</div>
