{% comment %}
  Clean academic timeline education entries for RenderCV format
{% endcomment %}

{% for entry in entries %}
  <div class="cv-entry">
    <div class="cv-entry-date">
      {% capture start_date %}
        {% if entry.start_date %}{{ entry.start_date }}{% elsif entry.startDate %}{{ entry.startDate }}{% endif %}
      {% endcapture %}
      {% capture end_date %}
        {% if entry.end_date %}{{ entry.end_date }}{% elsif entry.endDate %}{{ entry.endDate }}{% endif %}
      {% endcapture %}

      {% if start_date != '' %}
        {% assign startDate = start_date | split: '-' | first %}
        {% assign endDate = end_date | split: '-' | first | default: 'Present' %}
        <span class="cv-date-range">{{ startDate }} – {{ endDate }}</span>
      {% endif %}

      {% capture location %}
        {% if entry.location %}{{ entry.location }}{% endif %}
      {% endcapture %}
      {% if location != '' %}
        <span class="cv-entry-location">{{ location }}</span>
      {% endif %}
    </div>

    <div class="cv-entry-content">
      {% capture study_type %}
        {% if entry.studyType %}{{ entry.studyType }}{% elsif entry.degree %}{{ entry.degree }}{% endif %}
      {% endcapture %}

      {% if entry.url %}
        <h4 class="cv-entry-title">
          <a href="{{ entry.url }}">{{ study_type }}</a>
          {%- if entry.area -%}
            <span class="cv-entry-area">, {{ entry.area }}</span>
          {%- endif %}
        </h4>
      {% elsif study_type != '' %}
        <h4 class="cv-entry-title">
          {{ study_type -}}
          {%- if entry.area -%}
            <span class="cv-entry-area">, {{ entry.area }}</span>
          {%- endif %}
        </h4>
      {% endif %}

      {% if entry.institution %}
        <div class="cv-entry-subtitle">{{ entry.institution }}</div>
      {% endif %}

      {% if entry.courses or entry.highlights %}
        <ul class="cv-entry-highlights">
          {% for item in entry.courses %}
            {% if item != '' %}
              <li>{{ item }}</li>
            {% endif %}
          {% endfor %}
          {% for item in entry.highlights %}
            {% if item != '' %}
              <li>{{ item | markdownify | remove: '<p>' | remove: '</p>' }}</li>
            {% endif %}
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  </div>
{% endfor %}
