---
layout: default
---
<link rel="stylesheet" href="{{ '/assets/css/group-guide.css' | relative_url | bust_file_cache }}">
<link rel="stylesheet" href="{{ '/assets/css/research.css' | relative_url | bust_file_cache }}">

<div class="group-guide research-guide">
  <header class="group-guide__header">
    <a class="group-guide__back" href="{{ '/' | relative_url }}">Jiang Group / Research</a>
    <h1>{{ page.heading | default: page.title }}</h1>
    {% if page.description %}
      <p>{{ page.description }}</p>
    {% endif %}
  </header>

  <nav class="research-guide__topics" aria-label="Research themes">
    <a href="#energy-dominance">Energy dominance</a>
    <a href="#circular-economy">Circular economy</a>
    <a href="#physics-informed-ml">Physics-informed machine learning</a>
  </nav>

  <article class="group-guide__content research-guide__content" aria-label="Research">
    {{ content }}
  </article>
</div>
